# Локальный PostgreSQL из docker-compose.yml. На Vercel используйте строку подключения Supabase Transaction pooler.
DATABASE_URL=postgresql://moneymap:local-development-only@localhost:5433/moneymap
DATABASE_SSL=disable
APP_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Один или два заранее разрешённых Google email для первоначальной привязки.
# После первого входа их неизменяемые Google sub закрепляются в БД.
ALLOWED_GOOGLE_EMAIL_1=
# Необязательно до подключения второго пользователя.
ALLOWED_GOOGLE_EMAIL_2=
# Необязательно. Строка для миграций; на Vercel — Session pooler Supabase (только Production).
# Если не задана, миграции используют DATABASE_URL.
MIGRATION_DATABASE_URL=
